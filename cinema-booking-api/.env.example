# Cinema Booking API Environment Variables
# Copy this file to .env and fill in your values

# ===== DATABASE =====
DB_NAME=cinema_booking
DB_USERNAME=cinema_user
DB_PASSWORD=CHANGE_ME_STRONG_PASS

# ===== REDIS =====
# (managed internally by Docker, no change needed)
REDIS_HOST=redis
REDIS_PORT=6379

# ===== JWT =====
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_JWT_SECRET_RUN_openssl_rand_-base64_64

# ===== MB BANK (dvsteam.vn) =====
# Lấy token tại: https://api.dvsteam.vn
MBBANK_API_TOKEN=6bd280d48b4920b21ccef3a5569a5258
MBBANK_ACCOUNT_NUMBER=0348950574
MBBANK_ACCOUNT_NAME=DANG QUOC ANH

# ===== EMAIL (optional - for notifications) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== CORS =====
# In production behind Nginx, use * or your domain
CORS_ORIGINS=*
